[Unit]
Description=一个壳子
Requires=network.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/ashell --service
# kill --tray and --server both
ExecStop=pkill -f "ashell --"
# below two lines do not work, have to use above one line
#ExecStop=pkill -f "ashell --tray"
#ExecStop=pkill -f "ashell --server"
PIDFile=/run/ashell.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
